# Environment
ENVIRONMENT=development

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Or use AWS_PROFILE for SSO/role-based auth:
# AWS_PROFILE=sandbox

# LLM Models (via Bedrock)
LLM_ANALYSIS_MODEL=us.anthropic.claude-sonnet-4-20250514
LLM_HEAVY_MODEL=us.anthropic.claude-opus-4-20250514
LLM_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001
EMBEDDING_MODEL=cohere.embed-english-v3

# Database
DATABASE_URL=postgresql+asyncpg://wiki:wiki_dev_password@localhost:5432/wiki_engine

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant
QDRANT_URL=http://localhost:6333

# Git
GIT_CLONE_DIR=/tmp/wiki-engine/repos
